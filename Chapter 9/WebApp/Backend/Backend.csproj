<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework for agent orchestration -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.24.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.24.0" />
    
    <!-- Microsoft Extensions AI for IChatClient abstraction -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    
    <!-- Swagger/OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    
    <!-- Azure Services -->
    <PackageReference Include="Azure.Search.Documents" Version="11.5.1" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.19.1" />
    
    <!-- PDF Processing -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    
    <!-- Utilities -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
