page 50405 "Create Event Project"
{
    PageType = PromptDialog;
    Extensible = false;
    Caption = 'Create Event Project';
    DataCaptionExpression = JobDescription;
    IsPreview = true;

    layout
    {
        area(Prompt)
        {
            field(InputEventBrief; InputEventBrief)
            {
                ApplicationArea = All;
                ShowCaption = false;
                MultiLine = true;
                InstructionalText = 'Describe the event project you want to create. You can paste the Event Brief from Chapter 2.';
            }
        }
        area(Content)
        {
            field(JobShortDescription; JobDescription)
            {
                ApplicationArea = All;
                Caption = 'Project Short Description';
                ToolTip = 'Short title of the event project generated by Copilot.';
            }
            field(JobFullDetails; JobFullDescription)
            {
                ApplicationArea = All;
                MultiLine = true;
                Caption = 'Details';
                ToolTip = 'Full description of the event project generated by Copilot.';
            }
            field(SuggestedCustomer; CustomerName)
            {
                ApplicationArea = All;
                Caption = 'Suggested Customer';
                ToolTip = 'Company or customer name suggested by Copilot for Bill-to Customer. You can edit before saving.';
            }
            part(ProposalDetails; "Event Project Proposal Subpart")
            {
                Caption = 'Project Tasks';
                ShowFilter = false;
                ApplicationArea = All;
                Editable = true;
                Enabled = true;
            }
        }
    }

    actions
    {
        area(SystemActions)
        {
            systemaction(Generate)
            {
                Caption = 'Generate';
                ToolTip = 'Generate event project and tasks with Copilot.';

                trigger OnAction()
                begin
                    GenerateEventProject();
                end;
            }
            systemaction(OK)
            {
                Caption = 'Keep it';
                ToolTip = 'Save the event project proposed by Copilot.';
            }
            systemaction(Cancel)
            {
                Caption = 'Discard it';
                ToolTip = 'Discard the event project proposed by Copilot.';
            }
        }
    }

    trigger OnQueryClosePage(CloseAction: Action): Boolean
    begin
        if CloseAction = CloseAction::OK then
            ApplyEventProject();
    end;

    local procedure GenerateEventProject()
    var
        EventProjectProposal: Record "Event Project Proposal";
        CreateEventProjectImpl: Codeunit "Create Event Project Impl";
    begin
        CreateEventProjectImpl.GenerateEventProject(InputEventBrief, JobDescription, JobFullDescription, CustomerName, EventProjectProposal);
        CurrPage.ProposalDetails.Page.Load(EventProjectProposal);
    end;

    local procedure ApplyEventProject()
    var
        EventProjectProposal: Record "Event Project Proposal";
        SaveEventProjectImpl: Codeunit "Save Event Project Impl";
    begin
        CurrPage.ProposalDetails.Page.GetRecords(EventProjectProposal);
        EventProjectProposal.FindFirst();
        EventProjectProposal."Customer Name" := CustomerName;
        EventProjectProposal.Modify();
        SaveEventProjectImpl.ApplyEventProject(EventProjectProposal);
    end;

    var
        InputEventBrief: Text;
        JobDescription: Text[100];
        JobFullDescription: Text;
        CustomerName: Text[100];
}
